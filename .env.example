# Secrets only. Non-secret runtime settings should be stored in configs/*.yaml.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
METASO_API_KEY=
SOGOU_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.2
MIMO_API_KEY=
WRITER_REMOTE_BASE_URL=
WRITER_REMOTE_API_KEY=
WRITER_REMOTE_MODEL=

# FastAPI / Docker service settings
HOST=0.0.0.0
PORT=7860

# Local RAG model cache. Keep these paths stable so PDF retrieval uses local BGE models.
HF_HOME=models/huggingface
SENTENCE_TRANSFORMERS_HOME=models/sentence_transformers
TRANSFORMERS_CACHE=models/huggingface/transformers
HF_HUB_DISABLE_SYMLINKS_WARNING=1
