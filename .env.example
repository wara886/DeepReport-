# Secrets only. Non-secret runtime settings should be stored in configs/*.yaml.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
TUSHARE_TOKEN=
FRED_API_KEY=
BLS_API_KEY=
BEA_API_KEY=
SEC_USER_AGENT=Your Name contact@example.com
FINSIGHT_VECTOR_DB_PATH=data/vector_db
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.2
MIMO_API_KEY=
WRITER_REMOTE_BASE_URL=
WRITER_REMOTE_API_KEY=
WRITER_REMOTE_MODEL=

# FastAPI / Docker service settings
HOST=0.0.0.0
PORT=7860

# Local RAG model cache. Keep these paths stable so PDF retrieval uses local BGE models.
FINSIGHT_MODEL_CACHE_ROOT=models
HF_HOME=models/huggingface
SENTENCE_TRANSFORMERS_HOME=models/sentence_transformers
HF_HUB_DISABLE_SYMLINKS_WARNING=1
