{
  "overview": "This report analyzes Apple Inc.'s (AAPL) fundamental business performance, competitive advantages, and core risks for Q4 2025, with evidence-based conclusions and compliance disclosures.",
  "research_topic": "总结AAPL在2025Q4的业务基本面、优势与核心风险",
  "requirements": [
    "覆盖收入、利润率、现金流、风险、市场表现和近期新闻",
    "所有关键结论必须绑定 evidence_id",
    "输出 Markdown、HTML、JSON、trace 和验证报告"
  ],
  "output_format": "markdown, html, json with citations",
  "tasks": [
    {
      "task_id": "task_001",
      "task_type": "browser",
      "description": "Collect Q4 2025 AAPL financial statements and SEC filings",
      "parameters": {
        "url": "https://www.sec.gov/edgar"
      },
      "dependencies": [],
      "priority": 5,
      "expected_output": "PDF/HTML financial statements with evidence_ids"
    },
    {
      "task_id": "task_002",
      "task_type": "deep_researcher",
      "description": "Extract revenue, margin, and cash flow metrics from Q4 2025 filings",
      "parameters": {
        "symbol": "AAPL",
        "period": "2025Q4"
      },
      "dependencies": [
        "task_001"
      ],
      "priority": 4,
      "expected_output": "Structured financial data with evidence_ids"
    },
    {
      "task_id": "task_003",
      "task_type": "browser",
      "description": "Gather market performance data and recent news (last 6 months)",
      "parameters": {
        "queries": [
          "AAPL stock price 2025",
          "Apple quarterly results 2025"
        ]
      },
      "dependencies": [
        "task_001"
      ],
      "priority": 4,
      "expected_output": "News articles and market data with evidence_ids"
    },
    {
      "task_id": "task_004",
      "task_type": "deep_analyze",
      "description": "Identify competitive advantages and core risks from technical analysis",
      "parameters": {
        "focus": "business model, supply chain, regulatory risks"
      },
      "dependencies": [
        "task_002",
        "task_003"
      ],
      "priority": 3,
      "expected_output": "Risk/advantage analysis with evidence_ids"
    },
    {
      "task_id": "task_005",
      "task_type": "final_answer",
      "description": "Synthesize all findings into structured report format",
      "parameters": {
        "formats": [
          "markdown",
          "html",
          "json"
        ]
      },
      "dependencies": [
        "task_002",
        "task_004",
        "task_003"
      ],
      "priority": 5,
      "expected_output": "Complete report artifacts with citations"
    },
    {
      "task_id": "task_006",
      "task_type": "verifier",
      "description": "Validate all claims against original sources",
      "parameters": {
        "strict": true
      },
      "dependencies": [
        "task_005"
      ],
      "priority": 5,
      "expected_output": "Verification report with compliance status"
    }
  ],
  "data_sources": [
    "SEC EDGAR database",
    "Yahoo Finance",
    "Bloomberg Terminal",
    "Reuters News Archive",
    "Apple Investor Relations"
  ],
  "citations_required": true,
  "final_outputs": [
    "markdown",
    "html",
    "json",
    "trace",
    "verification_report"
  ],
  "fallback_used": false
}