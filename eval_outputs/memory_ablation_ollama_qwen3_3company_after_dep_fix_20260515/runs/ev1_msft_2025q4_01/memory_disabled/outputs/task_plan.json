      "expected_output": "包含财报链接、新闻摘要的JSON数据"
    },
    {
      "task_id": "task_002",
      "task_type": "deep_researcher",
      "description": "提取收入、利润率、现金流等核心财务指标并标注证据ID",
      "parameters": {
        "symbol": "MSFT",
        "period": "2025Q4"
      },
      "dependencies": [
        "task_001"
      ],
      "priority": 4,
      "expected_output": "结构化财务数据（收入、利润率、现金流）"
    },
    {
